{
  "name": "whiteboard-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "preview": "vite preview",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test:worker": "node --test tests/local-worker.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@eslint/js": "^10.0.1",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Generate a new random value using openssl rand -hex 32."
      },
      "BETTER_AUTH_URL": {
        "description": "Set the canonical public HTTPS origin of your Whiteboard Worker."
      },
      "GOOGLE_CLIENT_ID": {
        "description": "Optional Google OAuth client ID."
      },
      "GOOGLE_CLIENT_SECRET": {
        "description": "Optional Google OAuth client secret."
      }
    }
  },
  "license": "MIT"
}
